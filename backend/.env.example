# ── Agentic AI QA System V2 — Backend env (V2_CONTRACT §6) ──────────────────
# Copy to .env and adjust. NEVER commit real secrets (SEC-002).

# Application
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database — driver switch (SQLite is the no-Docker dev fallback, §5)
#   DB_DRIVER=postgres  → uses DATABASE_URL (pg)
#   DB_DRIVER=sqlite    → uses a local file (better-sqlite3), synchronize:true
DB_DRIVER=sqlite
DATABASE_URL=postgres://qa:qa@localhost:5432/qa_v2
SQLITE_FILE=./qa_v2.dev.sqlite

# Auth — JWT access (15m) + refresh cookie (7d)
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded admin (created on first boot if absent)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin

# Engine (compute service) — token is server-side only, never sent to browser
ENGINE_URL=http://localhost:8100
ENGINE_TOKEN=dev-engine-token

# Ollama (reported through /health via engine)
QA_OLLAMA_BASE_URL=http://localhost:11434

# GitHub integration (fine-grained token, least privilege, SEC-001) — server-side only
GITHUB_TOKEN=

# Uploads / evidence
UPLOAD_DIR=./evidence
MAX_UPLOAD_BYTES=26214400
