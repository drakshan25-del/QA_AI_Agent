# Copy to .env and adjust. Never commit real secrets (SEC-002).

# --- Application ---
QA_DATABASE_URL=sqlite:///./qa_agents.db
QA_ARTIFACTS_DIR=artifacts
QA_REPORTS_DIR=reports
QA_GENERATED_TESTS_DIR=automation/generated_tests

# --- Local LLM (Ollama) ---
QA_OLLAMA_BASE_URL=http://localhost:11434
QA_LLM_MODEL=qwen2.5:latest
QA_LLM_TEMPERATURE=0.1
# Dedicated code model for the Automation Agent; falls back to QA_LLM_MODEL
# if unset or not pulled in Ollama.
QA_LLM_CODER_MODEL=qwen2.5-coder:7b

# --- Target application under test ---
QA_TARGET_BASE_URL=https://agentstaging.keepme.ai/login
# Comma-separated domain allow-list for browser navigation (SEC-003)
QA_ALLOWED_DOMAINS=localhost,127.0.0.1,agentstaging.keepme.ai

# --- Test credentials: reference via env, never hard-code (FR-PROJ-004) ---
QA_TEST_USERNAME=your-test-user@example.com
QA_TEST_PASSWORD=change-me

# --- GitHub integration (fine-grained token, least privilege, SEC-001) ---
QA_GITHUB_REPO=
GITHUB_TOKEN=
