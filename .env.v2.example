# --- V3 additions -----------------------------------------------------------
# Engine call timeout (ms); local LLM generation can take minutes.
ENGINE_TIMEOUT_MS=600000
# Hard job timeout (ms) -> status `timed_out` (SRS §23.7).
JOB_TIMEOUT_MS=1800000

# Execution queue + admin-defined runtime limits (FR-V3-EXE-011/012).
EXEC_MAX_CONCURRENT=1
EXEC_MAX_TIMEOUT_SECONDS=1800
EXEC_MAX_RETRIES=3
EXEC_MAX_WORKERS=4
EXEC_MAX_SLOWMO_MS=2000

# Retention windows in days; 0 keeps records forever (FR-V3-ENT-011).
RETENTION_JOB_LOG_DAYS=0
RETENTION_EXECUTION_EVENT_DAYS=0
RETENTION_EVIDENCE_DAYS=0
RETENTION_SWEEP_INTERVAL_MINUTES=720

# --- UI Scanner Agent (FR-UIS-*) --------------------------------------------
# Concurrent scans; each one drives its own browser process.
UI_SCAN_MAX_CONCURRENT=2
UI_SCAN_MAX_CONCURRENT_PER_PROJECT=1
# Scans a project may start per minute.
UI_SCAN_RATE_PER_MINUTE=6
# Default and ceiling for the per-scan time limit (ms).
UI_SCAN_TIMEOUT_MS=45000
UI_SCAN_MAX_TIMEOUT_MS=300000
# Default and ceiling for elements collected per scan.
UI_SCAN_MAX_ELEMENTS=250
UI_SCAN_ELEMENT_CEILING=1000
# Largest screenshot stored per scan (bytes).
UI_SCAN_MAX_SCREENSHOT_BYTES=8388608
# SSRF escape hatch: allow scanning loopback/private addresses. Leave false in
# any shared environment; a project's allowedDomains re-enables named hosts.
UI_SCAN_ALLOW_PRIVATE_NETWORK=false
